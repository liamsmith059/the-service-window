#!/usr/bin/env python3
"""Apply or bump the cache-busting ?v= query string.

GitHub Pages serves CSS, JS and images with max-age=14400, so a new
deploy can look stale for up to four hours unless URLs change.

Usage:
  scripts/set-asset-version              # apply the id in ./asset-version
  scripts/set-asset-version 20261126a    # write that id, then apply

Updates:
  - ./asset-version
  - local stylesheet and script tags in every HTML page
  - home-page hub tile src/srcset URLs
  - the ASSET_VERSION constant in js/app.js, js/podcasts.js,
    js/screening-room.js and js/memories.js (used for pairing photos,
    show art, posters and memory photographs built at runtime)
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VERSION_FILE = ROOT / "asset-version"
JS_FILES = [
    ROOT / "js/app.js",
    ROOT / "js/podcasts.js",
    ROOT / "js/screening-room.js",
    ROOT / "js/memories.js",
]
VERSION_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def read_version(cli: str | None) -> str:
    if cli:
        version = cli.strip()
    else:
        version = VERSION_FILE.read_text().strip().splitlines()[0].strip()
    if not VERSION_RE.match(version):
        raise SystemExit(f"invalid asset version: {version!r}")
    return version


def bust_url(url: str, version: str) -> str:
    # Only local relative CSS/JS (already filtered by caller)
    url = re.sub(r"\?v=[A-Za-z0-9._-]+$", "", url)
    return f"{url}?v={version}"


def update_html(text: str, version: str) -> str:
    def css_js(m: re.Match) -> str:
        attr, url = m.group(1), m.group(2)
        if re.match(r"https?:", url) or url.startswith("//"):
            return m.group(0)
        return f'{attr}="{bust_url(url, version)}"'

    text = re.sub(
        r'((?:href|src))="([^"]+\.(?:css|js))(?:\?v=[A-Za-z0-9._-]+)?"',
        css_js,
        text,
    )

    def hub(m: re.Match) -> str:
        url = re.sub(r"\?v=[A-Za-z0-9._-]+", "", m.group(1))
        return f"{url}?v={version}"

    text = re.sub(
        r'(images/hub/[A-Za-z0-9._-]+\.webp)(?:\?v=[A-Za-z0-9._-]+)?',
        hub,
        text,
    )
    return text


def update_js(text: str, version: str) -> str:
    new, n = re.subn(
        r'var ASSET_VERSION = "[A-Za-z0-9._-]+";',
        f'var ASSET_VERSION = "{version}";',
        text,
        count=1,
    )
    if n != 1:
        raise SystemExit("ASSET_VERSION constant not found")
    return new


def main() -> None:
    version = read_version(sys.argv[1] if len(sys.argv) > 1 else None)
    VERSION_FILE.write_text(version + "\n")
    changed = 0
    for path in sorted(ROOT.rglob("*.html")):
        if ".git" in path.parts:
            continue
        original = path.read_text()
        updated = update_html(original, version)
        if updated != original:
            path.write_text(updated)
            changed += 1
            print(f"  {path.relative_to(ROOT)}")
    for path in JS_FILES:
        original = path.read_text()
        updated = update_js(original, version)
        if updated != original:
            path.write_text(updated)
            changed += 1
            print(f"  {path.relative_to(ROOT)}")
        else:
            print(f"  {path.relative_to(ROOT)} (version already {version})")
    print(f"asset version {version} applied")


if __name__ == "__main__":
    main()
